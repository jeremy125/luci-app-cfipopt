'use strict';

import { popen, readfile } from 'fs';

const TMP = '/tmp/cfipopt';
const RUN = '/usr/libexec/cfipopt/run.sh';

function safeRead(p) {
	try {
		const s = readfile(p);
		return (s == null) ? '' : s;
	}
	catch (e) {
		return '';
	}
}

const methods = {
	get_status: {
		call: function() {
			const res = {
				state: trim(safeRead(TMP + '/state')) || 'idle',
				total: 0,
				done: 0,
				log: safeRead(TMP + '/log'),
				result: safeRead(TMP + '/result.txt'),
				proxy: null
			};

			const cand = safeRead(TMP + '/candidates.txt');
			if (length(trim(cand)))
				res.total = length(split(trim(cand), '\n'));

			const p = popen('ls ' + TMP + '/results 2>/dev/null | wc -l');
			if (p) {
				res.done = int(trim(p.read('all')));
				p.close();
			}

			const pj = safeRead(TMP + '/proxy.json');
			if (length(pj)) {
				try {
					res.proxy = json(pj);
				}
				catch (e) {}
			}

			const us = safeRead(TMP + '/update_status.json');
			if (length(us)) {
				try {
					res.update = json(us);
				}
				catch (e) {}
			}
			res.update_progress = trim(safeRead(TMP + '/update_progress'));

			return res;
		}
	},

	start: {
		call: function() {
			popen(RUN + ' start >/dev/null 2>&1');
			return { ok: true };
		}
	},

	stop: {
		call: function() {
			popen(RUN + ' stop >/dev/null 2>&1');
			return { ok: true };
		}
	},

	proxy: {
		call: function() {
			popen(RUN + ' proxy >/dev/null 2>&1');
			return { ok: true };
		}
	},

	check_update: {
		call: function(req) {
			const force = (req && req.args && req.args.force) ? ' force' : '';
			const p = popen(RUN + ' check_update' + force);
			let out = '';
			if (p) {
				out = p.read('all') || '';
				p.close();
			}
			try {
				return json(trim(out));
			}
			catch (e) {
				return { installed: null, latest: null, update_available: false, download_url: '' };
			}
		}
	},

	update: {
		call: function() {
			// 后台执行: 下载 + opkg 安装 + 延迟重启
			popen(RUN + ' update >/dev/null 2>&1 &');
			return { ok: true };
		}
	}
};

return { 'luci.cfipopt': methods };
